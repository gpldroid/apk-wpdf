---
import Layout from '../../layouts/SiteLayout.astro';
import { tools } from '../../data/tools.js';
export function getStaticPaths() { return tools.map(tool => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const related = tools.filter(item => item.category === tool.category && item.slug !== tool.slug).slice(0,3);
---
<Layout title={`${tool.name} مجاناً | World PDF`} description={tool.desc} canonical={`https://wpdf.online/tools/${tool.slug}/`}>
  <section class="page-hero tool-page-hero"><div class="container"><p class="breadcrumb"><a href="/">الرئيسية</a><span>/</span><a href="/tools/">الأدوات</a><span>/</span>{tool.name}</p><div class="tool-hero-layout"><div><span class="section-kicker">{tool.category}</span><h1>{tool.name}</h1><p>{tool.desc}</p><div class="tool-hero-actions"><a class="button button-primary button-large" href={`/workspace/?tool=${tool.id}`}>استخدم الأداة الآن <span aria-hidden="true">←</span></a><span class="file-type-note">الصيغ: {tool.accept}</span></div></div><div class="tool-hero-icon" aria-hidden="true">{tool.icon}</div></div></div></section>
  <section class="section"><div class="container tool-detail-layout"><article class="detail-content"><div class="detail-block"><span class="section-kicker">خطوات الاستخدام</span><h2>كيف تستخدم {tool.name}؟</h2><ol class="steps-list">{tool.steps.map((step,index) => <li><span>{String(index+1).padStart(2,'0')}</span><p>{step}</p></li>)}</ol></div><div class="detail-block"><span class="section-kicker">متى تحتاج إليها؟</span><h2>استخدامات الأداة</h2><p>{tool.benefit}</p></div><div class="detail-note"><b>ملاحظة حول الملفات</b><p>{tool.id === 'compress' ? 'لا يمكن ضمان تقليل الحجم في كل ملف؛ يعتمد ذلك على الصور والخطوط والبيانات الداخلية للمستند.' : tool.id === 'word' ? 'قد يحتاج المستند الناتج إلى مراجعة يدوية، لأن استخراج النص لا يحافظ دائماً على التخطيط الأصلي.' : 'تختلف النتيجة بحسب بنية المستند والمتصفح. احتفظ دائماً بنسخة أصلية من الملف قبل المعالجة.'}</p></div><div class="detail-block"><h2>الخصوصية</h2><p>تعمل المعالجة داخل المتصفح في الأدوات التي تدعم ذلك. لا تغلق صفحة العمل أثناء تنفيذ العملية، وتحقق من الملف الناتج قبل استخدامه.</p><a class="text-link" href="/privacy/">تفاصيل سياسة الخصوصية <span aria-hidden="true">←</span></a></div></article><aside class="tool-sidebar"><div class="sidebar-card"><span class="sidebar-icon">{tool.icon}</span><h2>ابدأ باستخدام الأداة</h2><p>{tool.short}</p><a class="button button-primary" href={`/workspace/?tool=${tool.id}`}>فتح مساحة المعالجة</a><span class="sidebar-meta">نوع الملف: {tool.accept}</span></div><div class="sidebar-card sidebar-related"><h2>أدوات ذات صلة</h2>{related.length ? related.map(item => <a href={`/tools/${item.slug}/`}>{item.name}<span>←</span></a>) : <a href="/tools/">تصفح جميع الأدوات <span>←</span></a>}</div></aside></div></section>
</Layout>
