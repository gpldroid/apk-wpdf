import Layout from '../../layouts/SiteLayout.astro';import {tools} from '../../data/tools.js';
---
<Layout title="جميع أدوات PDF — World PDF" description="تصفح جميع أدوات World PDF لمعالجة ملفات PDF وتحويلها وتنظيم صفحاتها." canonical="https://wpdf.online/tools/"><section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/">الرئيسية</a> / الأدوات</p><h1>جميع أدوات PDF</h1><p>اختر الأداة التي تحتاجها وانتقل إلى صفحة الاستخدام المخصصة لها.</p></div></section><section class="section"><div class="container tool-grid">{tools.map(t=><a class="tool-card" href={`/tools/${t.slug}/`}><span class="tool-icon">PDF</span><span><h2>{t.name}</h2><p>{t.desc}</p></span></a>)}</div></section></Layout>
