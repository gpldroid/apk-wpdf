
---
import Layout from '../layouts/SiteLayout.astro';
import { tools, categories } from '../data/tools.js';
const featured = tools.slice(0, 6);
---
<Layout title="أدوات PDF مجانية — دمج وتحويل وضغط الملفات | World PDF" description="استخدم أدوات PDF المجانية لدمج الملفات وتقسيمها وتحويلها وتنظيم صفحاتها. معالجة مباشرة في المتصفح دون تثبيت برامج." keywords="أدوات PDF مجانية، دمج ملفات PDF، تقسيم PDF، ضغط PDF، تحويل PDF إلى Word، تحويل الصور إلى PDF، محرر PDF">
<section class="hero"><div class="container hero-layout"><div class="hero-copy"><span class="eyebrow"><span class="eyebrow-dot"></span> أدوات PDF سهلة ومجانية</span><h1>أنجز أعمال PDF<br /><span>بخطوات أقل.</span></h1><p>ادمج مستنداتك، قسّم الصفحات، حوّل الملفات ونظّمها. اختر الأداة المناسبة وابدأ مباشرة من متصفحك.</p><div class="hero-actions"><a class="button button-primary button-large" href="/tools/">استكشف جميع الأدوات <span aria-hidden="true">←</span></a><a class="button button-ghost button-large" href="/pdf-editor.html">افتح محرر PDF</a></div><div class="hero-proof"><span>✓ بدون تثبيت برامج</span><span>✓ واجهة عربية</span><span>✓ أدوات مباشرة من المتصفح</span></div></div><div class="hero-visual" aria-label="معاينة توضيحية لأدوات PDF"><div class="visual-glow"></div><div class="document-card document-back"><span class="document-label">PDF</span><i></i><i></i><i></i></div><div class="document-card document-front"><div class="document-top"><span class="file-mark">PDF</span><span class="file-status">جاهز للعمل</span></div><div class="document-lines"><i></i><i></i><i></i><i></i></div><div class="document-bottom"><span>World PDF</span><b>↗</b></div></div><div class="floating-tool floating-tool-one"><span>＋</span> دمج الملفات</div><div class="floating-tool floating-tool-two"><span>⇅</span> تنظيم الصفحات</div></div></div></section>
<section class="trust-strip" aria-label="مميزات الخدمة"><div class="container trust-grid"><div><b>{tools.length}</b><span>أداة PDF متاحة</span></div><div><b>0</b><span>برامج تحتاج تثبيتها</span></div><div><b>متصفحك</b><span>مساحة المعالجة</span></div><div><b>مجاناً</b><span>للمهام اليومية</span></div></div></section>
<section class="section tools-section" id="tools"><div class="container"><div class="section-heading section-heading-row"><div><span class="section-kicker">مجموعة الأدوات</span><h2>كل ما تحتاجه لملفات PDF</h2><p>اختر المهمة المناسبة، اقرأ تفاصيلها، ثم افتح أداة المعالجة في الصفحة نفسها.</p></div><a class="text-link" href="/tools/">عرض جميع الأدوات <span aria-hidden="true">←</span></a></div><div class="category-pills" aria-label="تصنيفات الأدوات">{categories.filter(c => c !== 'الكل').map(c => <span>{c}</span>)}</div><div class="tool-grid">{featured.map((tool,index) => <a class="tool-card" href={`/tools/${tool.slug}/#tool`} data-tool={tool.id}><span class="tool-card-icon">{tool.icon}</span><span class="tool-card-content"><span class="tool-card-category">{tool.category}</span><h3>{tool.name}</h3><p>{tool.short}</p><span class="tool-card-link">اكتشف الأداة <b aria-hidden="true">←</b></span></span><span class="tool-number">{String(index+1).padStart(2,'0')}</span></a>)}</div></div></section>
<section class="section workflow-section" id="how-it-works"><div class="container"><div class="section-heading"><span class="section-kicker">طريقة سهلة</span><h2>من الملف الأصلي إلى النتيجة</h2><p>ثلاث خطوات واضحة لإنجاز المهمة التي تريدها.</p></div><div class="workflow-grid"><article class="workflow-card"><span class="step-number">01</span><div class="step-icon">▤</div><h3>اختر الأداة</h3><p>حدد المهمة من الأدوات المتاحة، مثل الدمج أو التقسيم أو التحويل.</p></article><article class="workflow-card"><span class="step-number">02</span><div class="step-icon">⇧</div><h3>أضف ملفاتك</h3><p>اختر المستندات من جهازك واضبط الخيارات التي تحتاج إليها.</p></article><article class="workflow-card"><span class="step-number">03</span><div class="step-icon">↓</div><h3>نزّل النتيجة</h3><p>نفّذ العملية ثم احفظ الملف الناتج وراجعه قبل مشاركته.</p></article></div></div></section>
<section class="section privacy-section" id="about"><div class="container privacy-panel"><div class="privacy-symbol">⌑</div><div><span class="section-kicker">حول الموقع</span><h2>أدوات واضحة للمهام اليومية</h2><p>يجمع World PDF أدوات للتعامل مع مستندات PDF في واجهة واحدة. تعرّف على كل أداة من صفحتها المخصصة، وراجع سياسة الخصوصية وشروط الاستخدام قبل البدء.</p><a class="text-link" href="/about/">تعرف على World PDF <span aria-hidden="true">←</span></a></div></div></section>
<section class="section all-tools-section"><div class="container all-tools-panel"><div><span class="section-kicker">جاهز للبدء؟</span><h2>اختر أداتك وابدأ الآن</h2><p>تصفح المجموعة الكاملة وانتقل إلى صفحة الأداة التي تناسب احتياجك.</p></div><a class="button button-primary button-large" href="/tools/">تصفح الأدوات ({tools.length}) <span aria-hidden="true">←</span></a></div></section>
<section class="section contact-section" id="contact"><div class="container contact-inner"><div><span class="section-kicker">نحن هنا للمساعدة</span><h2>لديك ملاحظة أو اقتراح؟</h2><p>يسعدنا استقبال ملاحظاتك حول الأدوات وتجربة الاستخدام.</p></div><a class="button button-outline" href="/contact/">تواصل معنا</a></div></section>
</Layout>
