---
import Header from '../components/SiteHeader.astro';
import Footer from '../components/SiteFooter.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import '../styles/global.css';
const { title = 'World PDF — أدوات PDF مجانية وسهلة الاستخدام', description = 'أدوات مجانية لدمج وتقسيم وتحويل وتنظيم ملفات PDF مباشرة من المتصفح.', canonical = 'https://wpdf.online/', keywords = 'أدوات PDF مجانية، دمج PDF، تقسيم PDF، ضغط PDF، تحويل PDF', noindex = false, type = 'website' } = Astro.props;
const fullTitle = title.includes('World PDF') ? title : `${title} | World PDF`;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#b91c1c" /><meta name="color-scheme" content="light dark" />
<meta name="google-adsense-account" content="ca-pub-6996931662051674" />
<meta name="google-site-verification" content="eUswbZSa1Op5doTXhulMQ6KZyBci0izcvZ8k661pRsE" />
<meta name="description" content={description} /><meta name="keywords" content={keywords} />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
<link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="manifest" href="/manifest.webmanifest" /><link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
<noscript><link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" /></noscript>
<meta property="og:type" content={type} /><meta property="og:site_name" content="World PDF" /><meta property="og:locale" content="ar_AR" />
<meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://wpdf.online/assets/icons/og-image.svg" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={fullTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content="https://wpdf.online/assets/icons/og-image.svg" />
<title>{fullTitle}</title>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6996931662051674" crossorigin="anonymous"></script>
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KC52SRXL');</script>
<script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'WebSite', name:'World PDF', url:'https://wpdf.online/', inLanguage:'ar', description })}></script>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KC52SRXL" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
<Header /><main id="main-content"><slot /></main><Footer /><MobileTabBar />
<script src="/assets/js/analytics.js" defer></script><script>import '../scripts/site.js';</script>
</body></html>
