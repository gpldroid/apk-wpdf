
---
import { mobileNavigation } from '../data/navigation.js';
const currentPath = Astro.url.pathname;
---
<nav class="mobile-tabbar" aria-label="التنقل السريع">{mobileNavigation.map(item => <a href={item.href} aria-label={item.label} aria-current={currentPath === item.href || (item.href === '/tools/' && currentPath.startsWith('/tools/')) ? 'page' : undefined}><span aria-hidden="true">{item.icon}</span><small>{item.label}</small></a>)}</nav>
